# Copy to .env and fill in values. Never commit .env (gitignored).
#
# OpenRouter API key — required before any generation spend (issues S7+).
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Durable copy of run artifacts. Required for --backend lora.
# gs://hecate-506120-artifacts or file:///absolute/path (tests / local debug).
HECATE_ARTIFACTS_URI=
# If 1, every runner (including scripted/frozen) must have HECATE_ARTIFACTS_URI.
HECATE_REQUIRE_ARTIFACTS=
